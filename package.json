{
  "name": "dsh-local-file-reference",
  "version": "0.1.0",
  "description": "Paste local files into the DeepSeek Harness composer as path-backed attachment references",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lwt-sadais/dsh-local-file-reference.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["sessions", "inputTriggers"]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.zh.md"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
